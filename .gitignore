# numbers reported in the paper -- stay in-tree as the summary/CSV/PNG files
# alongside these directories. See "Experiment outputs" in the README.
our_approach/experiments/*/
baselines/kggen/experiments/*/
baselines/rakg/experiments/*/
evaluation_pipeline/mine_score/results/*/
evaluation_pipeline/faithfulness/results/*/
evaluation_pipeline/faithfulness/qwen_32b_results/*/
