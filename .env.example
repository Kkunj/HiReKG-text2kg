# Environment variables for the HiReKG pipeline.
# Copy this file to `.env` and fill in your own credentials before running.
# Do NOT commit your real .env.

# --- OpenAI (used by GPT-4o experiments and Batch API runs) ---
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Secondary OpenAI key (optional — used when one key hits rate limits)
OPENAI_API_KEY_2=<YOUR_SECOND_OPENAI_API_KEY>

# --- Azure OpenAI (optional alternative to OpenAI direct) ---
OPENAI_AZURE_URL=<YOUR_AZURE_OPENAI_ENDPOINT>
OPENAI_AZURE_KEY=<YOUR_AZURE_OPENAI_KEY>

# --- Google Gemini (used by the verifier in fact_generation) ---
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# --- Anthropic (optional) ---
ANTROPIC_API=<YOUR_ANTHROPIC_API_KEY>

# --- NVIDIA NIM endpoint (optional) ---
NVIDIA_ENDPOINT_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENDPOINT_API=<YOUR_NVIDIA_NIM_KEY>

# --- Self-hosted / local vLLM endpoint ---
# Point this at your own OpenAI-compatible chat-completions URL.
LOCAL_LLM_URL=http://<LOCAL_LLM_HOST>:<PORT>/v1/chat/completions
